{
  "name": "liima",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "backend:build": "cd ./../../ && mvn clean install -DskipTests && ./AMW_docker/build.sh && cd ./AMW_angular/io",
    "backend:start": "docker compose -f ./../../AMW_docker/docker-compose/docker-compose.yml up -d",
    "backend:stop": "docker compose -f ./../../AMW_docker/docker-compose/docker-compose.yml down",
    "build": "ng build",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "lint": "ng lint",
    "prettier": "npx prettier --write .",
    "mavenbuild": "ng build --configuration production",
    "maventest": "ng test --watch=false",
    "postinstall": "husky || true",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.2",
    "@angular/compiler": "^22.0.2",
    "@angular/core": "^22.0.2",
    "@angular/forms": "^22.0.2",
